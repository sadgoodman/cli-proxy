# Keep every text file at LF in the working tree, whatever the platform.
# Without this, a Windows checkout converts Go sources to CRLF and `gofmt -l`
# reports the whole tree as unformatted.
* text=auto eol=lf

# Artifacts that must never be mangled.
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.zip binary
*.gz binary
*.tar binary
*.exe binary
